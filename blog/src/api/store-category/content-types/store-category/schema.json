{
  "kind": "collectionType",
  "collectionName": "store_categories",
  "info": {
    "singularName": "store-category",
    "pluralName": "store-categories",
    "displayName": "store_category"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "products": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product.product",
      "mappedBy": "store_category"
    }
  }
}
